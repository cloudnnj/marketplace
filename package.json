{
  "name": "crewdeck",
  "version": "0.38.0",
  "description": "AI Project Management Platform - JIRA for AI Agents",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/validate-preload-format.js",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-node-pty.js && node scripts/fix-sqlite-vec.js && node scripts/install-mcp-servers.js",
    "restart": "./scripts/restart-dev.sh",
    "cleanup": "./scripts/cleanup-worktrees.sh",
    "sessions": "./scripts/list-claude-sessions.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:migrate-task-numbers": "npx tsx scripts/db/migrate-task-numbers.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . --format json --output-file eslint-report.json || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder --mac --win --linux",
    "version:patch": "npm version patch --no-git-tag-version && node scripts/version-bump.js",
    "version:minor": "npm version minor --no-git-tag-version && node scripts/version-bump.js",
    "version:major": "npm version major --no-git-tag-version && node scripts/version-bump.js",
    "release": "node scripts/release.js",
    "stats": "node scripts/generate-stats.js",
    "merge-prs": "./scripts/batch-merge-prs.sh",
    "merge-prs:dry": "./scripts/batch-merge-prs.sh --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.116",
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/utils": "3.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.0.2",
    "@octokit/rest": "^22.0.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "bonjour-service": "^1.3.0",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.1.7",
    "fastify": "^5.8.5",
    "fix-path": "^5.0.0",
    "js-yaml": "^4.1.1",
    "lz4js": "^0.2.0",
    "nanoid": "^5.1.7",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.0.0",
    "sqlite-vec": "0.1.9",
    "zod": "^4.3.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/lz4js": "^0.2.2",
    "@types/node": "~25.6.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "drizzle-kit": "^0.31.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.0.2",
    "globals": "^17.5.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.2",
    "vite-plugin-static-copy": "^3.3.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.27.0",
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    },
    "lodash": "^4.18.0",
    "minimatch": "^10.2.1",
    "tar": "^7.5.11",
    "@develar/schema-utils": {
      "ajv": "^6.14.0"
    },
    "undici": "^7.24.4",
    "flatted": "^3.4.2",
    "@xmldom/xmldom": "^0.8.13"
  }
}
